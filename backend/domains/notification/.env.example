# development | test | production. Bỏ trống = coi như production (stub membership từ chối tất cả)
NODE_ENV=development
PORT=3002
WEB_ORIGIN=http://localhost:5173
# PHẢI trùng JWT_SECRET của Identity (Đạt). Tối thiểu 32 ký tự
JWT_SECRET=
# openssl rand -hex 32 — tối thiểu 24 ký tự
INTERNAL_SERVICE_TOKEN=
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/notification?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Dev: docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit  → xem mail ở http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexus <no-reply@nexus.local>"
OTP_TTL_SECONDS=60
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# openssl rand -hex 32 — tối thiểu 32 ký tự
OTP_HMAC_SECRET=

# Dọn dữ liệu cũ (chạy 03:00 mỗi ngày). Giá trị <= 0 hoặc sai định dạng → dùng mặc định
NOTIFICATION_RETENTION_DAYS=90
MAIL_LOG_RETENTION_DAYS=180
RETENTION_BATCH_SIZE=1000
