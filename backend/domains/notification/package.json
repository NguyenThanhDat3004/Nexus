{
  "name": "notification",
  "version": "1.0.0",
  "description": "- **Port nội bộ:** `3002`\r - **Công nghệ:** Node.js / NestJS / BullMQ hoặc Kafka / SMTP Mailer\r - **Phụ trách chính:** Phúc",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts"
    ],
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4"
  }
}