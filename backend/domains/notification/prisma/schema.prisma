generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  notification_id String                  @id @default(uuid()) @db.Uuid
  /// UNIQUE: event gửi lặp (retry) không tạo thông báo trùng
  event_id        String                  @unique @db.VarChar(64)
  type            String                  @db.VarChar(64)
  title           String                  @db.VarChar(200)
  body            String                  @db.VarChar(2000)
  project_id      String?                 @db.VarChar(64)
  channel_id      String?                 @db.VarChar(64)
  actor_user_id   String?                 @db.VarChar(64)
  payload         Json?
  occurred_at     DateTime                @db.Timestamptz(3)
  created_at      DateTime                @default(now()) @db.Timestamptz(3)
  recipients      NotificationRecipient[]

  @@index([project_id])
  @@index([created_at])
  @@map("notifications")
}

model NotificationRecipient {
  notification_id String       @db.Uuid
  user_id         String       @db.VarChar(64)
  read_at         DateTime?    @db.Timestamptz(3)
  notification    Notification @relation(fields: [notification_id], references: [notification_id], onDelete: Cascade)

  @@id([notification_id, user_id])
  @@index([user_id, read_at])
  @@map("notification_recipients")
}

enum MailTemplate {
  INVITATION
  OTP
}

enum MailStatus {
  SENT
  FAILED
}

model MailLog {
  mail_id         String       @id @default(uuid()) @db.Uuid
  recipient_email String       @db.VarChar(254)
  template        MailTemplate
  status          MailStatus
  error           String?      @db.VarChar(500)
  created_at      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([created_at])
  @@index([recipient_email, created_at])
  @@map("mail_logs")
}