# Nexus External Integration — biến môi trường
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# KHÔNG dùng PAT ở bất cứ đâu — mọi truy cập GitHub/Jira đều qua OAuth2.

# --- Chung ---
PORT=3003
APP_BASE_URL=http://localhost:3003

# --- GitHub OAuth App ---
# Đạt đăng ký tại: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3003
# Authorization callback URL: http://localhost:3003/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3003/integrations/github/callback
# Scope xin khi authorize: repo (đọc/ghi repo + quản lý webhook), read:user (thông tin user)
GITHUB_OAUTH_SCOPES=repo read:user
# Secret dùng để ký webhook GitHub (tự sinh: openssl rand -hex 32).
# Phải trùng với secret khai báo khi tạo webhook trên GitHub.
GITHUB_WEBHOOK_SECRET=

# --- Jira OAuth 2.0 (3LO) ---
# Tạo app tại Atlassian Developer Console: https://developer.atlassian.com/console/myapps/
# Chọn "OAuth 2.0 (3LO)", thêm API "Jira platform REST API" + các scope dưới đây,
# Callback URL: http://localhost:3003/integrations/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3003/integrations/jira/callback
# Site Jira của team (dùng cho webhook admin qua REST API cũ, nếu cần)
JIRA_SITE_URL=https://3004nguyenthanhdat.atlassian.net
# Scopes: read:jira-user (thông tin user), read:jira-work (đọc issue/sprint),
# write:jira-work (chuyển trạng thái issue — chỉ dùng khi team đã chốt),
# manage:jira-webhook (đăng ký webhook động), offline_access (refresh token)
JIRA_OAUTH_SCOPES=read:jira-user read:jira-work write:jira-work manage:jira-webhook offline_access
# Secret ký webhook Jira (chỉ có tác dụng với webhook admin tạo qua Jira System → WebHooks
# hoặc POST /rest/webhooks/1.0/webhook kèm "secret"). Webhook động qua POST /rest/api/3/webhook
# KHÔNG dùng secret này — xem README mục "Webhook Jira được xác thực thế nào".
JIRA_WEBHOOK_SECRET=

# --- Ghi ngược trạng thái sang Jira ---
# Mặc định TẮT. Endpoint POST /integrations/jira/issues/{issueKey}/status chỉ hoạt động
# khi bật = true, vì nó chạm tới phía Jira Automation của Đạt — CẦN TEAM XÁC NHẬN trước.
JIRA_WRITEBACK_ENABLED=false
