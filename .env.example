# ==============================================================================
# NEXUS ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Copy file này thành file ".env" (lệnh: cp .env.example .env)
# 2. Điền thông tin kết nối và mật khẩu phù hợp với máy của bạn vào file ".env"
# 3. File ".env" đã được cho vào .gitignore nên sẽ KHÔNG BAO GIỜ bị lộ lên GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CỔNG MẠNG (PORTS) CỦA CÁC SERVICE
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
IDENTITY_SERVICE_PORT=8081
WORKSPACE_SERVICE_PORT=8082
COLLABORATION_SERVICE_PORT=3001
NOTIFICATION_SERVICE_PORT=3002
INTEGRATION_SERVICE_PORT=3003

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (DÙNG CHUNG HOST, KHÁC TÊN DATABASE)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Tên Database của từng Domain (Khởi tạo từ database/init-databases.sql):
DB_IDENTITY_NAME=nexus_identity
DB_WORKSPACE_NAME=nexus_workspace
DB_COLLABORATION_NAME=nexus_collaboration

# ------------------------------------------------------------------------------
# 3. BỘ NHỚ ĐỆM & KHÓA PHÂN TÁN (REDIS)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. CHỨNG THỰC & BẢO MẬT (SECURITY & JWT)
# ------------------------------------------------------------------------------
# Khóa bí mật ký Token JWT (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên):
JWT_SECRET=nexus_super_secret_jwt_signing_key_2026_xyz_do_not_leak
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 5. DỊCH VỤ BÊN THỨ 3 (GOOGLE OAUTH, SMTP MAIL) - [CẤU HÌNH KHI CẦN]
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cấu hình gửi mail OTP (Gửi qua Gmail SMTP hoặc Mailhog lúc dev):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
